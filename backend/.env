# SheTech Mobile Backend — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env com credenciais reais.

# ── Provedor de LLM ───────────────────────────────────────────────────────────
# "mock"    → análise determinística, sem credenciais (padrão)
# "watsonx" → IBM watsonx.ai (preencha as chaves abaixo)
# "openai"  → OpenAI (preencha OPENAI_API_KEY abaixo)
LLM_PROVIDER=mock

# ── IBM watsonx.ai (apenas se LLM_PROVIDER=watsonx) ──────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── OpenAI (apenas se LLM_PROVIDER=openai) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

# ── Banco de dados ────────────────────────────────────────────────────────────
# Arquivo SQLite criado em backend/shetech.db
DATABASE_URL=sqlite:///./shetech.db

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# IMPORTANTE: troque este valor por uma string aleatória longa em produção!
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=shetech-mobile-dev-secret-mude-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
# True  → aceita qualquer origem (desenvolvimento, emulador + celular físico)
# False → usa apenas os IPs listados em CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=True

# IPs permitidos quando CORS_ALLOW_ALL_ORIGINS=False
# Exemplo: CORS_ALLOWED_ORIGINS=http://192.168.1.10:8081,http://10.0.2.2:8081
CORS_ALLOWED_ORIGINS=

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=2000
